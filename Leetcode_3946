class Solution:
    def maximumSaleItems(self, items, budget):
        MAXF = 1500

        # Count how many items have each factor
        freq = [0] * (MAXF + 1)

        for f, p in items:
            freq[f] += 1

        # bonus[f] = number of items whose factor is divisible by f
        bonus = [0] * (MAXF + 1)

        for f in range(1, MAXF + 1):
            for multiple in range(f, MAXF + 1, f):
                bonus[f] += freq[multiple]

        # Group items according to their prices
        groups = {}

        for f, p in items:
            if p <= budget:
                groups.setdefault(p, []).append(bonus[f])

        # dp[c] = maximum bonus value using exactly c money
        dp = [-1] * (budget + 1)
        dp[0] = 0

        ans = 0

        # Process prices from highest to lowest
        for price in sorted(groups, reverse=True):
            # Subsets containing at least one item of this price
            used = [-1] * (budget + 1)

            for value in groups[price]:
                for c in range(budget, price - 1, -1):

                    if dp[c - price] != -1:
                        used[c] = max(
                            used[c],
                            dp[c - price] + value
                        )

                    if used[c - price] != -1:
                        used[c] = max(
                            used[c],
                            used[c - price] + value
                        )

                    dp[c] = max(
                        dp[c],
                        dp[c - price] + value
                    )

            # Calculate the answer when this is the cheapest
            # selected item
            for c in range(budget + 1):
                if used[c] != -1:
                    total = used[c] + (budget - c) // price
                    ans = max(ans, total)

        return ans
